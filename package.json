{
  "name": "cgprism",
  "version": "1.0.0",
  "type": "module",
  "bin": {
    "cgprism": "./src/cli/main.js"
  },
  "scripts": {
    "start": "node ./src/cli/main.js",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "validate": "prettier --check . || prettier --write ."
  },
  "dependencies": {
    "@mdtui/markedit-terminal-render": "^0.1.0",
    "better-sqlite3": "^13.0.3",
    "pg": "^8.23.0",
    "systeminformation": "^5.33.19"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.25.0"
  },
  "pkg": {
    "targets": [
      "node22-linux-x64",
      "node22-linux-arm64",
      "node22-macos-x64",
      "node22-macos-arm64",
      "node22-win-x64"
    ],
    "outputPath": "dist"
  }
}
